# 输出产物
outputs/
# 一次性诊断/基准脚本的输出日志(含本机绝对路径与大量冗余 stdout, 不入库;
# 结论已整理进 docs/superpowers/plans/2026-10-03-qwen-image-edit-migration.md)
*.log
__pycache__/
*.pyc
*.pyo
*.pyd

# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.npmcache/
# npm 的本地缓存目录。sandbox 下 npm 无法写 %LOCALAPPDATA% 时会退到
# 项目根建这个, 与已有的 frontend/.npmcache/ 是同一类东西。
.npm-cache/
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# Playwright 验证脚本跑出来的截图与成片(verify-*.mjs 本身入库,产物不入库)
frontend/*.png
frontend/*.jpg

# 模型权重与 HuggingFace 缓存(体积大,不入库)
# 说明:vendor 下只有 ip_adapter/ 是自研源码,需要入库;
#       clip_vision/ 与 hf_cache/ 是权重和缓存,可通过 setup 脚本重新获取
backend/vendor/hf_cache/
backend/vendor/clip_vision/
*.safetensors
*.ckpt
*.bin
*.onnx
*.pth

# 环境
.env
.env.local
.venv/
venv/
.cuda_cache/

# Qwen-Image-Edit 专用虚拟环境。
# 与 SDXL 那套(在 E:\Code\stable-diffusion-webui\.venv)彻底隔离,因为
# diffusers 0.40 强制 transformers 5.x + huggingface-hub 1.x,而 SDXL 需要
# transformers 4.37.2。两者不能共存于同一环境。
# 版本组合见 requirements-qwen.txt,可用 pip -r 重建,不入库。
.venv-qwen/

# 项目内隔离安装的第三方依赖(PEFT 等)
# 共享的 webui venv 缺 PEFT 且不允许写入,因此装到项目内 .pylibs,
# 由 backend/peft_compat.py 在运行时注入 sys.path。
# 体积大且可由 pip --target 重建,不入库。
.pylibs/
.pipcache/
.piptmp/

# 蒙版素材校验脚本的产物(contact sheet),preview_samples.py 每次重生成
scripts/mask_assets/preview.png

# 临时工作目录(手工调试时的草稿/截图)。.tmp/ 不是 .gitignore 的默认规则,
# 显式列出以免漏掉根目录与任意层级的同名目录。
.tmp/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
